---
import Archive from '../../../layouts/Archive.astro';
import CourseMaterials from '../../../components/CourseMaterials.astro';
import { pageTwin } from '../../../lib/urls';
import { sectionCrumb } from '../../../lib/crumbs';
import { langFromPath, pagePath } from '../../../lib/paths';

const path = pagePath(Astro.url);
const lang = langFromPath(path);
const teaching = sectionCrumb('/teaching/', lang);
---
<Archive crumbs={teaching && [teaching]} title="Course Materials for Students" lang={lang} twin={pageTwin(path, lang)} description="Tutorial notes, lecture notes, and slides for the courses I teach at Concordia University — free to view and download.">

<p class="page__lead">
  Notes and slides I prepare for the courses I assist at Concordia University.
  Everything here is free to view and download. If a file you are looking for is
  missing, or you spot an error in one, please <a href="/contact/">let me know</a>.
</p>

<div class="materials-note">
  <i class="fas fa-info-circle" aria-hidden="true"></i>
  <span>
    These are supplementary materials written to support the tutorials and labs.
    They do not replace your instructor's lecture notes, the course textbook, or
    anything posted on Moodle, and the official course outline always takes
    precedence.
  </span>
</div>

<CourseMaterials lang={lang} />

<div class="materials-note materials-licence">
  <i class="fab fa-creative-commons" aria-hidden="true"></i>
  <span>
    © Parsa Kamalipour. Except where otherwise noted, the course materials on
    this page are licensed under a <a rel="license" href="https://creativecommons.org/licenses/by-nc-sa/4.0/">Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License</a> (CC BY-NC-SA 4.0). You may share and adapt them for non-commercial purposes,
    provided you credit the author, link to the licence, indicate if changes were
    made, and release any adaptations under the same licence. Uploading them to
    paid note-sharing or homework-help sites is a commercial use and is not
    permitted. Problems quoted from textbooks, assignments, or other sources
    remain the property of their copyright holders and are not covered by this
    licence. Suggested credit: “[Title], Parsa Kamalipour, CC BY-NC-SA 4.0,
    parsakp.com/teaching/materials/”.
  </span>
</div>

<p><a class="btn btn--news" href="/teaching/"><i class="fas fa-chalkboard-teacher" aria-hidden="true"></i> Back to teaching</a></p>
</Archive>
