---
import Archive from '../../../../layouts/Archive.astro';
import CourseMaterials from '../../../../components/CourseMaterials.astro';
import { pageTwin } from '../../../../lib/urls';
import { sectionCrumb } from '../../../../lib/crumbs';
import { langFromPath, pagePath } from '../../../../lib/paths';

const path = pagePath(Astro.url);
const lang = langFromPath(path);
const teaching = sectionCrumb('/teaching/', lang);
---
<Archive crumbs={teaching && [teaching]} title="Matériel de cours pour les étudiants" lang={lang} twin={pageTwin(path, lang)} description="Notes de tutoriel, notes de cours et diapositives pour les cours auxquels je participe à l'Université Concordia — à consulter et à télécharger librement.">

<p class="page__lead">
  Notes et diapositives que je prépare pour les cours auxquels je participe à
  l’Université Concordia. Tout le contenu est libre de consultation et de
  téléchargement. S’il manque un document, ou si vous relevez une erreur, <a href="/fr/contact/">faites-le moi savoir</a>.
</p>

<div class="materials-note">
  <i class="fas fa-info-circle" aria-hidden="true"></i>
  <span>
    Il s’agit de matériel complémentaire rédigé pour appuyer les tutoriels et les
    laboratoires. Il ne remplace ni les notes de cours de votre enseignant, ni le
    manuel du cours, ni ce qui est publié sur Moodle&nbsp;; le plan de cours
    officiel a toujours préséance.
  </span>
</div>

<CourseMaterials lang={lang} />

<div class="materials-note materials-licence">
  <i class="fab fa-creative-commons" aria-hidden="true"></i>
  <span>
    © Parsa Kamalipour. Sauf mention contraire, le matériel de cours de cette
    page est mis à disposition selon les termes de la <a rel="license" href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.fr">licence Creative Commons Attribution - Pas d’Utilisation Commerciale - Partage dans les Mêmes Conditions 4.0 International</a> (CC BY-NC-SA 4.0). Vous pouvez le partager et l’adapter à des fins non
    commerciales, à condition de créditer l’auteur, d’indiquer un lien vers la
    licence, de signaler les modifications effectuées et de diffuser toute
    adaptation sous la même licence. Le téléverser sur des sites payants de
    partage de notes ou d’aide aux devoirs constitue une utilisation commerciale
    et n’est pas autorisé. Les problèmes repris de manuels, de devoirs ou
    d’autres sources restent la propriété de leurs titulaires de droits et ne
    sont pas visés par cette licence. Crédit suggéré&nbsp;: «&nbsp;[Titre], Parsa
    Kamalipour, CC BY-NC-SA 4.0, parsakp.com/fr/enseignement/materiel/&nbsp;».
  </span>
</div>

<p><a class="btn btn--news" href="/fr/enseignement/"><i class="fas fa-chalkboard-teacher" aria-hidden="true"></i> Retour à l’enseignement</a></p>
</Archive>
