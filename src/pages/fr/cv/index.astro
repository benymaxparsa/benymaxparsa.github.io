---
import Archive from '../../../layouts/Archive.astro';
import { pageTwin } from '../../../lib/urls';
import { langFromPath, pagePath } from '../../../lib/paths';

const path = pagePath(Astro.url);
const lang = langFromPath(path);
---
<Archive title="CV" lang={lang} twin={pageTwin(path, lang)}>
<div class="cv-actions">
  <a id="cv-fr" class="cv-btn primary" href="/files/FR_ParsaKamalipour_CV.pdf" download aria-label="Télécharger le CV en français PDF">
    Télécharger le CV (Français, PDF)
  </a>
  <a class="cv-btn secondary" href="/files/ParsaKamalipour_CV.pdf" download aria-label="Download CV in English PDF">
    Download CV (English, PDF)
  </a>
  <div class="cv-meta"><b><u>Dernière mise à jour du CV : <i>5 août 2025</i></u></b></div>
</div>

<div class="cv-ctrl">
  <label for="cv-lang">Voir :</label>
  <select id="cv-lang" name="cv-lang" aria-label="Sélectionner la langue du CV à prévisualiser">
    <option value="/files/FR_ParsaKamalipour_CV.pdf" selected>Français (PDF)</option>
    <option value="/files/ParsaKamalipour_CV.pdf">English PDF</option>
  </select>
</div>

<div class="cv-viewer">
  <iframe
    id="cv-frame"
    class="cv-iframe"
    src="/files/FR_ParsaKamalipour_CV.pdf"
    title="Aperçu du CV"
    allow="fullscreen"
  ></iframe>
</div>
<script>
  // Preview the CV in the language picked in the selector
  const select = document.querySelector<HTMLSelectElement>('#cv-lang');
  const frame = document.querySelector<HTMLIFrameElement>('#cv-frame');
  select?.addEventListener('change', () => { if (frame) frame.src = select.value; });
</script>
</Archive>
