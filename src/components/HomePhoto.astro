---
// Rotating portrait: one of nine photos, never one of the last three this visitor saw.
// The inline script sets src so exactly one image is fetched; width/height reserve the box.
interface Props { alt: string }
const { alt } = Astro.props;
---
<img class="home-hero__photo" id="home-photo" width="400" height="400" alt={alt} fetchpriority="high" decoding="async">
<script is:inline>
  (function () {
    var img = document.getElementById('home-photo');
    var n = 9, seen = [], pick;
    try { seen = JSON.parse(localStorage.getItem('lastThreeImages')) || []; } catch (e) {}
    do { pick = '/images/Profile_Pictures/sm/p' + (1 + Math.floor(Math.random() * n)) + '.jpg'; }
    while (seen.indexOf(pick) !== -1 && seen.length < n);
    seen.push(pick);
    try { localStorage.setItem('lastThreeImages', JSON.stringify(seen.slice(-3))); } catch (e) {}
    img.src = pick;
  })();
</script>
<noscript><img class="home-hero__photo" src="/images/Profile_Pictures/sm/p1.jpg" width="400" height="400" alt={alt}></noscript>
