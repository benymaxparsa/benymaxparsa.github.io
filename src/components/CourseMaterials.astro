---
// Course blocks for the materials page; the file list is whatever is in each course's folder.
import { readFileSync } from 'node:fs';
import { parse } from 'yaml';
import { staticFiles, prettyName, pdfCreated } from '../lib/files';
import { ui, type Lang } from '../i18n';

interface Course {
  code: string; name: string; role: string; terms: string; blurb?: string; dir: string;
  titles?: Record<string, string>; topics?: Record<string, string>;
  fr?: Partial<Pick<Course, 'name' | 'role' | 'terms' | 'blurb' | 'titles' | 'topics'>>;
}

const { lang } = Astro.props as { lang: Lang };
const { courses } = parse(readFileSync('src/data/course_materials.yml', 'utf8')) as { courses: Course[] };
const empty = lang === 'fr' ? 'Le matériel de ce cours sera publié ici au cours de la session.' : 'Materials for this course will be posted here during the term.';
---
<div class="course-materials-grid">
{courses.map((course) => {
  const tr = (lang === 'fr' && course.fr) || {};
  const files = staticFiles(course.dir).sort((a, b) => pdfCreated(a) - pdfCreated(b)); // oldest first
  const blurb = tr.blurb ?? course.blurb;
  return (
    <details class="course-materials" id={course.code.toLowerCase().replace(/\s+/g, '-')}>
      <summary class="course-materials__header">
        <h2 class="course-materials__title">
          <span class="course-materials__code">{course.code}</span>
          {tr.name ?? course.name}
        </h2>
        <span class="course-materials__meta">
          {tr.role ?? course.role} <span class="course-materials__sep" aria-hidden="true">•</span> {tr.terms ?? course.terms}
          <span class="course-materials__sep" aria-hidden="true">•</span> <span class="course-materials__count">{ui[lang].files(files.length)}</span>
        </span>
        <svg class="course-materials__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      {blurb && <p class="course-materials__blurb">{blurb}</p>}
      {files.length > 0 ? (
        <ul class="material-list">
          {files.map((file) => {
            const topics = tr.topics?.[file.name] ?? course.topics?.[file.name];
            return (
            <li class="material-item">
              <a class="material-link" href={file.path} download>
                <i class="fas fa-file-download" aria-hidden="true"></i>
                <span class="material-name">{tr.titles?.[file.name] ?? course.titles?.[file.name] ?? prettyName(file)}</span>
                <span class="material-ext">{file.extname.slice(1).toUpperCase()}</span>
              </a>
              {topics && <p class="material-topics">{topics}</p>}
            </li>
            );
          })}
        </ul>
      ) : (
        <p class="material-empty">
          <i class="fas fa-hourglass-half" aria-hidden="true"></i>
          {empty}
        </p>
      )}
    </details>
  );
})}
</div>
<script is:inline>
  // A link to #comp-339 opens that course
  (function () {
    function openHash() {
      var el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (el && el.tagName === 'DETAILS') el.open = true;
    }
    openHash();
    addEventListener('hashchange', openHash);
  })();
</script>
