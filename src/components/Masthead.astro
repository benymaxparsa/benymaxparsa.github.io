---
import { nav, groupOf, ui, type Lang } from '../i18n';
import { site } from '../lib/site';

interface Props { lang: Lang; twin: string; path: string }
const { lang, twin, path } = Astro.props;
const t = ui[lang];
const other = lang === 'en' ? 'fr' : 'en';
const current = groupOf(path, lang);
const norm = (u: string) => u.replace(/\/?$/, '/');
const here = (url: string) => (norm(path) === norm(url) ? 'page' : undefined);
const caret = '<svg class="nav-caret" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>';
---
<header class="nav-shell">
  <div class="nav-pill">
    <a class="nav-brand" href={t.home}>
      <img src={site.logo} alt="" width="512" height="512">
      <span class="nav-brand__name">{site.title}</span>
    </a>
    <nav id="site-nav" aria-label={t.navLabel}>
      <span class="nav-highlight" aria-hidden="true"></span>
      <ul class="nav-groups">
        {nav[lang].map((g, i) => (
          <li class="nav-group">
            {g.url
              ? <a class="nav-group__link" href={g.url} aria-current={here(g.url) ?? (current === g.title ? 'true' : undefined)}>{g.title}</a>
              : <>
                  <button type="button" class="nav-group__btn" aria-expanded="false" aria-controls={`nav-panel-${i}`} aria-current={current === g.title ? 'true' : undefined}>{g.title}<Fragment set:html={caret} /></button>
                  <ul class="nav-panel" id={`nav-panel-${i}`} hidden>
                    {g.items!.map((l) => <li><a href={l.url} aria-current={here(l.url)}>{l.title}</a></li>)}
                  </ul>
                </>}
          </li>
        ))}
      </ul>
    </nav>
    <div class="nav-tools">
      <button class="search__toggle icon-btn" type="button" aria-expanded="false" aria-label={t.search}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
      </button>
      <a href={twin} class="lang-switch-link icon-btn" data-lang={other} lang={other} hreflang={other === 'fr' ? 'fr-CA' : 'en'} aria-label={`${t.langOther} (${other.toUpperCase()})`}>{other.toUpperCase()}</a>
      <button class="theme-toggle icon-btn" type="button" data-label-dark={t.themeDark} data-label-light={t.themeLight} aria-label={t.themeToggle}>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"/></svg>
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/></svg>
      </button>
    </div>
    <button class="nav-menu-btn icon-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-label-open={t.menu} data-label-close={t.menuClose} aria-label={t.menu}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="navicon__open" d="M4 8h16M4 16h16"/><path class="navicon__close" d="m6 6 12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <div id="site-menu" class="nav-overlay" hidden>
    {nav[lang].map((g) => (
      <section class="nav-overlay__group">
        {g.url
          ? <a class="nav-overlay__title" href={g.url} aria-current={here(g.url)}>{g.title}</a>
          : <>
              <h2 class="eyebrow">{g.title}</h2>
              <ul>{g.items!.map((l) => <li><a href={l.url} aria-current={here(l.url)}>{l.title}</a></li>)}</ul>
            </>}
      </section>
    ))}
  </div>
</header>
