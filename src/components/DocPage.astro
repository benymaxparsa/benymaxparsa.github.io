---
import { render } from 'astro:content';
import Single from '../layouts/Single.astro';
import { docs, langOf, twinOf, urlOf, type Doc } from '../lib/urls';
import { excerpt } from '../lib/text';
import { sectionCrumb } from '../lib/crumbs';

interface Props { doc: Doc }
const { doc } = Astro.props;
const { Content } = await render(doc);
const lang = langOf(doc);
const twin = await twinOf(doc);
const tags = doc.data.tags ?? twin?.data.tags;

// Previous/next within the same collection and language, in collection order
const siblings = await docs(doc.collection, lang);
const i = siblings.findIndex((d) => d.id === doc.id);
const link = (d?: Doc) => d && { url: urlOf(d), title: d.data.title };
const section = sectionCrumb(`/${doc.collection}/`, lang);
---
<Single
  title={doc.data.title}
  lang={lang}
  twin={twin ? urlOf(twin) : lang === 'fr' ? '/' : '/fr/'}
  description={excerpt(doc.rendered?.html ?? '')}
  date={doc.data.date}
  classes={`doc--${doc.collection}`}
  share
  crumbs={section && [section]}
  pager={{ prev: link(siblings[i - 1]), next: link(siblings[i + 1]) }}
>
  {tags && <ul class="interest-tags" aria-label="Tags">{tags.map((tag) => <li class="interest-tag">{tag}</li>)}</ul>}
  <Content />
</Single>
